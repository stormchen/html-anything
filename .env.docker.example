# =============================================================================
# HTML Anything Docker 環境變數範例檔
# 請複製此檔案為 .env 並依需求修改：cp .env.docker.example .env
# =============================================================================

# 預設 AI 代理（可選值：ollama, gemini, claude, openclaw 等）
NEXT_PUBLIC_DEFAULT_AGENT=ollama

# 本地 AI 伺服器 (Ollama / MLX-VLM) 位址
# 若容器運行於 Mac mini，且 Ollama 直接運行在 Mac mini 系統本機上：
NEXT_PUBLIC_OLLAMA_URL=http://host.docker.internal:11434

# 預設模型名稱
NEXT_PUBLIC_OLLAMA_MODEL=qwen3.6:27b

# Google Gemini API Key（若要使用 Gemini，請填寫此欄位）
GEMINI_API_KEY=
